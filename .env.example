# Copy to .env and fill in. Never commit .env.

# Claude API key. A Claude Max subscription does not include API access.
ANTHROPIC_API_KEY=

# Models
MODEL_EXTRACT=claude-sonnet-5-5
MODEL_CLASSIFY=claude-haiku-5-5

# SQLite for local work and tests (a relative path is relative to backend/); a Postgres URL when deployed.
DATABASE_URL=sqlite:///./greenlight.db

# "recorded" replays saved AI responses and never calls the API (tests, demo fallback; the default).
# "live" calls the API (needs ANTHROPIC_API_KEY). "record" calls the API and saves each response.
AI_MODE=recorded
# Where recorded responses are kept (default: data/ai_recordings).
# AI_RECORDINGS_DIR=
AI_TIMEOUT_SECONDS=60

APP_ENV=dev

# Ports. Change these to run two copies side by side (for example in two worktrees).
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Where the Vite dev server forwards /api. Defaults to http://localhost:$BACKEND_PORT.
# API_PROXY_TARGET=
# Base URL the browser uses for API calls. Defaults to /api (through the dev server's proxy).
# VITE_API_BASE_URL=

# The backend listens on BACKEND_HOST (use 0.0.0.0 when deployed).
BACKEND_HOST=127.0.0.1

# Extra browser origins allowed to call the backend directly (comma-separated). The dev server on
# FRONTEND_PORT is always allowed, and the /api proxy needs none; set this for a deployed frontend.
FRONTEND_ORIGIN=
