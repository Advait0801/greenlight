# Copy to .env and fill in. Never commit .env.

# Claude API key. A Claude Max subscription does not include API access.
ANTHROPIC_API_KEY=

# Models
MODEL_EXTRACT=claude-sonnet-5-5
MODEL_CLASSIFY=claude-haiku-5-5

# SQLite for local work and tests; a Postgres URL when deployed.
DATABASE_URL=sqlite:///./greenlight.db

# "recorded" replays saved AI responses (tests, demo fallback). "live" calls the API.
AI_MODE=live

APP_ENV=dev
FRONTEND_ORIGIN=http://localhost:5173
