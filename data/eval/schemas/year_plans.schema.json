{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenlight.local/schemas/year_plans.schema.json",
  "title": "Year plan test set",
  "description": "Full year plans with the expected calendar (each event's dated obligations, same scope as the event test set), budget totals and flagged problems. Amounts are whole cents. How money on hand is split across events is decided in Phase 4; only totals are fixed here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["set", "version", "count", "method", "cases"],
  "properties": {
    "set": {"const": "year_plans"},
    "version": {"type": "integer", "minimum": 1},
    "count": {"const": 2},
    "method": {"type": "string", "minLength": 20},
    "cases": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "isoDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "ruleId": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "as_of", "club", "plan", "events", "expected"],
      "properties": {
        "id": {"type": "string", "pattern": "^yp-\\d{2}$"},
        "purpose": {"type": "string"},
        "as_of": {"$ref": "#/$defs/isoDate"},
        "club": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "mission", "level", "first_registered"],
          "properties": {
            "name": {"type": "string"},
            "mission": {"type": "string"},
            "level": {"enum": ["undergraduate", "graduate"]},
            "first_registered": {"$ref": "#/$defs/isoDate"}
          }
        },
        "plan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["period", "money_on_hand_cents", "expected_income_cents", "usg_received_this_year_cents", "unavailable_dates"],
          "properties": {
            "period": {"type": "string"},
            "money_on_hand_cents": {"type": "integer", "minimum": 0},
            "expected_income_cents": {"type": "integer", "minimum": 0},
            "usg_received_this_year_cents": {"type": "integer", "minimum": 0},
            "unavailable_dates": {"type": "array", "items": {"$ref": "#/$defs/isoDate"}}
          }
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "name", "event_date", "end_date", "venue", "headcount", "attributes", "estimated_cost_cents", "usg_request_cents"],
            "properties": {
              "key": {"type": "string", "pattern": "^[a-z0-9-]+$"},
              "name": {"type": "string"},
              "event_date": {"$ref": "#/$defs/isoDate"},
              "end_date": {"oneOf": [{"$ref": "#/$defs/isoDate"}, {"type": "null"}]},
              "venue": {"enum": ["venue_tes_meeting_room", "venue_tes_large", "venue_outdoor", "venue_classroom", "venue_off_campus"]},
              "headcount": {"type": "integer", "minimum": 0},
              "attributes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "estimated_cost_cents": {"type": "integer", "minimum": 0},
              "usg_request_cents": {"type": "integer", "minimum": 0}
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["calendar", "budget", "problems"],
          "properties": {
            "calendar": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["event", "rule_id", "status", "due"],
                "properties": {
                  "event": {"type": "string"},
                  "rule_id": {"$ref": "#/$defs/ruleId"},
                  "status": {"enum": ["to_do", "condition", "blocked", "office_decides", "check_with_office"]},
                  "due": {"oneOf": [{"$ref": "#/$defs/isoDate"}, {"type": "null"}]}
                }
              }
            },
            "budget": {
              "type": "object",
              "additionalProperties": false,
              "required": ["total_cost_cents", "funds_available_cents", "gap_before_usg_cents", "usg_requested_cents", "usg_requested_over_yearly_cap_cents"],
              "properties": {
                "total_cost_cents": {"type": "integer", "minimum": 0},
                "funds_available_cents": {"type": "integer", "minimum": 0},
                "gap_before_usg_cents": {"type": "integer", "minimum": 0},
                "usg_requested_cents": {"type": "integer", "minimum": 0},
                "usg_requested_over_yearly_cap_cents": {"type": "integer", "minimum": 0}
              }
            },
            "problems": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "rule_id", "events", "severity"],
                "properties": {
                  "type": {"enum": ["funded_events_over_semester_cap", "deadline_in_previous_semester_or_break", "event_in_blocked_period", "same_day_funding_requests", "not_fundable_as_described", "over_yearly_cap", "banned_money_source", "past_due"]},
                  "rule_id": {"$ref": "#/$defs/ruleId"},
                  "events": {"type": "array", "items": {"type": "string"}, "minItems": 1},
                  "severity": {"enum": ["red", "yellow", "office_decides"]},
                  "note": {"type": "string"}
                }
              }
            }
          }
        }
      }
    }
  }
}
