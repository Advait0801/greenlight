{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenlight.local/schemas/budgets.schema.json",
  "title": "Funding budget test set",
  "description": "USG funding budgets with seeded violations. Amounts are whole cents. `expected.lines` gives the verdict for every line; `expected.application` gives findings about the request as a whole. `seeded_violations` lists every planted mistake (the denominator for the catch rate). Deadlines are covered by the event test set and are not part of these cases. Expected findings list every red and office-decides finding and every seeded yellow; an engine may add other yellow notes (for example, confirm the vendor is on USG's list) without counting as wrongly flagged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "set",
    "version",
    "count",
    "method",
    "cases"
  ],
  "properties": {
    "set": {
      "const": "budgets"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "count": {
      "const": 20
    },
    "method": {
      "type": "string",
      "minLength": 20
    },
    "cases": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "ruleId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "verdict": {
      "enum": [
        "green",
        "yellow",
        "red",
        "office_decides"
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "verdict"
      ],
      "properties": {
        "rule_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/ruleId"
            },
            {
              "type": "null"
            }
          ]
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "note": {
          "type": "string"
        },
        "reason": {
          "enum": [
            "rule",
            "category_unclear",
            "duplicate_line",
            "totals_mismatch",
            "cannot_compute"
          ],
          "description": "Why the finding exists. 'rule' (the default) means the rule named in rule_id; the others are uncertainties that always mean yellow."
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "event",
        "club",
        "attachments",
        "lines",
        "quote_text",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^bu-\\d{2}$"
        },
        "purpose": {
          "type": "string",
          "minLength": 5
        },
        "event": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "description",
            "event_date",
            "end_date",
            "expected_attendance",
            "venue",
            "ticketed",
            "open_to_all_students"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "event_date": {
              "$ref": "#/$defs/isoDate"
            },
            "end_date": {
              "oneOf": [
                {
                  "$ref": "#/$defs/isoDate"
                },
                {
                  "type": "null"
                }
              ]
            },
            "expected_attendance": {
              "type": "integer",
              "minimum": 0
            },
            "venue": {
              "enum": [
                "venue_tes_meeting_room",
                "venue_tes_large",
                "venue_outdoor",
                "venue_classroom",
                "venue_off_campus"
              ]
            },
            "ticketed": {
              "type": "boolean"
            },
            "open_to_all_students": {
              "type": "boolean"
            }
          }
        },
        "club": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "usg_received_this_year_cents",
            "usg_funded_events_this_semester",
            "first_registered"
          ],
          "properties": {
            "usg_received_this_year_cents": {
              "type": "integer",
              "minimum": 0
            },
            "usg_funded_events_this_semester": {
              "type": "integer",
              "minimum": 0
            },
            "first_registered": {
              "$ref": "#/$defs/isoDate"
            }
          }
        },
        "attachments": {
          "type": "array",
          "uniqueItems": true,
          "description": "Documents attached to the application besides the per-line quotes.",
          "items": {
            "enum": [
              "esr",
              "hospitality_food_form",
              "food_health_permit_and_insurance",
              "food_justification",
              "statement_of_purpose",
              "traveler_information",
              "hotel_price_comparison",
              "hotel_point_of_contact",
              "lodging_justification"
            ]
          }
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "line",
              "vendor",
              "item",
              "category",
              "quantity",
              "unit_price_cents",
              "amount_cents",
              "has_quote",
              "purchase_channel"
            ],
            "properties": {
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "vendor": {
                "type": "string"
              },
              "item": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "quantity": {
                "type": "integer",
                "minimum": 0
              },
              "unit_price_cents": {
                "type": "integer",
                "minimum": 0
              },
              "amount_cents": {
                "type": "integer",
                "minimum": 0
              },
              "nights": {
                "type": "integer",
                "minimum": 1
              },
              "has_quote": {
                "type": "boolean"
              },
              "purchase_channel": {
                "enum": [
                  "vendor_quote",
                  "online_cart",
                  "amazon"
                ]
              },
              "has_cart_screenshot": {
                "type": "boolean"
              },
              "has_wish_list_link": {
                "type": "boolean"
              }
            }
          }
        },
        "quote_text": {
          "type": "string",
          "description": "What the uploaded quote says, as an officer would paste or upload it. Data only."
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total_cents",
            "food_per_person_cents",
            "lines",
            "application",
            "expected_fund",
            "acceptable_funds",
            "draft_allowed",
            "seeded_violations"
          ],
          "properties": {
            "total_cents": {
              "type": "integer",
              "minimum": 0
            },
            "food_per_person_cents": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "line",
                  "verdict",
                  "findings"
                ],
                "properties": {
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "verdict": {
                    "$ref": "#/$defs/verdict"
                  },
                  "findings": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/finding"
                    }
                  }
                }
              }
            },
            "application": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/finding"
              }
            },
            "expected_fund": {
              "oneOf": [
                {
                  "$ref": "#/$defs/ruleId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "acceptable_funds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ruleId"
              }
            },
            "draft_allowed": {
              "type": "boolean"
            },
            "seeded_violations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rule_id",
                  "where"
                ],
                "properties": {
                  "rule_id": {
                    "$ref": "#/$defs/ruleId"
                  },
                  "where": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
