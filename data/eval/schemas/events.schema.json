{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenlight.local/schemas/events.schema.json",
  "title": "Event sentence test set",
  "description": "Event sentences with the attributes, obligations and dates each should produce. Scope of `obligations`: rules from rules/events.json and rules/outside_money.json of kind deadline, requirement, cap, banned or blocked_period that apply to the event, plus rules from rules/funding.json of kind deadline, blocked_period or ineligible (event-level only) when the event asks for USG funding. Document rules for the USG application (quotes, permits, traveler details) belong to the money check and are not listed here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["set", "version", "count", "method", "cases"],
  "properties": {
    "set": {"const": "events"},
    "version": {"type": "integer", "minimum": 1},
    "count": {"const": 30},
    "method": {"type": "string", "minLength": 20},
    "cases": {"type": "array", "minItems": 30, "maxItems": 30, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "isoDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "ruleId": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sentence", "as_of", "purpose", "expected"],
      "properties": {
        "id": {"type": "string", "pattern": "^ev-\\d{2}$"},
        "sentence": {"type": "string", "minLength": 10, "maxLength": 2000},
        "as_of": {"$ref": "#/$defs/isoDate"},
        "purpose": {"type": "string", "minLength": 5},
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["event_date", "end_date", "venue", "headcount", "attributes", "needs_officer_input", "obligations", "source_conflicts"],
          "properties": {
            "event_date": {"oneOf": [{"$ref": "#/$defs/isoDate"}, {"type": "null"}]},
            "end_date": {"oneOf": [{"$ref": "#/$defs/isoDate"}, {"type": "null"}]},
            "venue": {"oneOf": [{"enum": ["venue_tes_meeting_room", "venue_tes_large", "venue_outdoor", "venue_classroom", "venue_off_campus"]}, {"type": "null"}]},
            "headcount": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
            "attributes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "needs_officer_input": {"type": "array", "items": {"enum": ["event_date", "venue", "headcount", "attributes"]}, "uniqueItems": true},
            "obligations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["rule_id", "status", "due", "violated", "past_due"],
                "properties": {
                  "rule_id": {"$ref": "#/$defs/ruleId"},
                  "status": {"enum": ["to_do", "condition", "blocked", "office_decides", "check_with_office"]},
                  "due": {"oneOf": [{"$ref": "#/$defs/isoDate"}, {"type": "null"}]},
                  "violated": {"type": "boolean"},
                  "past_due": {"type": "boolean"},
                  "note": {"type": "string"}
                }
              }
            },
            "source_conflicts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["rules", "applied"],
                "properties": {
                  "rules": {"type": "array", "items": {"$ref": "#/$defs/ruleId"}, "minItems": 2, "maxItems": 2},
                  "applied": {"oneOf": [{"$ref": "#/$defs/ruleId"}, {"type": "null"}]}
                }
              }
            }
          }
        }
      }
    }
  }
}
